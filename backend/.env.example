# ===== Savio Bosco Alphas 2012 — API environment =====

# PostgreSQL connection string.
# On Supabase: Dashboard → Project Settings → Database → Connection string
# (direct connection, host like db.<ref>.supabase.co).
DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
# Set to "true" if your connection requires SSL
DATABASE_SSL=false

# Supabase Storage (for uploaded images & documents).
# Dashboard → Storage → create a PUBLIC bucket named "uploads"
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role key>
SUPABASE_BUCKET=uploads
# Leave the two Supabase values empty for local development —
# files are then stored in ./uploads and served by this server.

# Admin session signing secret (use a long random string in production)
JWT_SECRET=change-me-to-a-long-random-string

# The Netlify frontend origin (for CORS). Your Netlify site URL.
FRONTEND_URL=https://your-site.netlify.app

# Port (Render sets this automatically)
PORT=8081
